{
  "description": "vocals 하네스(이슈 #17): 역할별 파일 쓰기 차단, 되돌리기 어려운 명령 차단, 위험한 Supabase MCP 도구 차단, 팀장 세션 시작 현황",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-files.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(create_project|pause_project|restore_project|create_branch|delete_branch|merge_branch|reset_branch|rebase_branch|apply_migration|execute_sql|deploy_edge_function|create_edge_function_secret|confirm_cost|run_notebook|create_notebook|delete_notebook)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-mcp.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
