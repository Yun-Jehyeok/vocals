{
  "name": "vocals",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:harness",
    "check:harness": "pnpm check:acceptance-guard && pnpm check:req-trace && pnpm check:erd-drift",
    "check:acceptance-guard": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/acceptance-guard.ts",
    "check:req-trace": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/check-req-trace.ts",
    "check:erd-drift": "pnpm --filter @vocals/supabase check:erd-drift",
    "db:reset": "pnpm --filter @vocals/supabase db:reset",
    "db:query": "pnpm --filter @vocals/supabase db:query"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
